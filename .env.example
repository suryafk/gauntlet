# Copy to .env and fill in. Never commit .env.

# mock | real
BOLNA_MODE=mock
BOLNA_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
# Agent ids. scripts/setup_bolna.py creates the agents and writes agents/agent_ids.json,
# which is used when these are empty.
BOLNA_TARGET_AGENT_ID=
BOLNA_CALLER_AGENT_ID=
# Public HTTPS URL Bolna can reach: your ngrok URL locally, or the host's URL.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# After a caller call ends, how long to wait for the target agent's side to arrive.
LINK_TIMEOUT_S=45
# Optional: a number bought in your Bolna account to dial from (E.164).
BOLNA_FROM_NUMBER=

# LLM that grades calls and drafts prompt patches: gemini (default) or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PATCH_MODEL=gemini-4-argon
# Only needed with LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# The ONLY number synthetic callers may dial (E.164), i.e. our flawed target agent.
TARGET_NUMBER=+910000000000

# Server-side hard cap on calls per run.
RUN_CALL_CAP=50
# Max simultaneous calls. Bolna trial accounts allow 2, paid accounts start at 10.
MAX_CONCURRENCY=10
# A call with no terminal webhook after this many seconds is marked failed.
CALL_TIMEOUT_S=300

# Sent by Bolna as a custom webhook header (X-Webhook-Secret); requests without it are rejected.
WEBHOOK_SECRET=change-me

DATABASE_URL=gauntlet.db

# Mock mode tuning
MOCK_CALL_MIN_S=1.0
MOCK_CALL_MAX_S=4.0
MOCK_DIAL_FAIL_RATE=0.05

# Judge/patcher: auto (LLM_PROVIDER when its key is set, else offline heuristic + rules) | heuristic | gemini | claude
JUDGE_MODE=auto
# Claude model, used only with LLM_PROVIDER=claude
JUDGE_MODEL=claude-opus-5-5

# Example run loaded when the database is empty (scripts/seed_run.py writes it)
SEED_ON_EMPTY=1
SEED_PATH=seed/example_run.json
